# Supabase (use Publishable key = anon key from Dashboard -> Settings -> API)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Client-side (browser) - required for anonymous auth so reminders/memory work
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Optional: direct Postgres URL (Supabase Dashboard -> Settings -> Database)
DATABASE_URL="postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Gemini
VITE_GEMINI_API_KEY=""
